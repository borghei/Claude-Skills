{
  "_about": "Pattern tables read by ai_slop_detector.py and its slop_*_checks.py layers. Regexes are Python re syntax. Grading only; fixes live in engineering/interface-refinement.",
  "stock_gradient": [
    "linear-gradient\\s*\\(\\s*(?:to\\s+(?:right|bottom|bottom\\s+right)|1[23]\\d\\s*deg|45\\s*deg)",
    "linear-gradient\\s*\\([^)]*(?:#[68-9a-f]{3,6}|purple|violet|indigo)[^)]*(?:#[0-6][0-9a-f]{5}|blue|cyan|teal)",
    "linear-gradient\\s*\\([^)]*(?:pink|#f[0-9a-f]{2}[0-5])[^)]*(?:orange|#f[89a-f]{2}[0-9a-f]{2})",
    "background:\\s*linear-gradient[^;]*,\\s*linear-gradient"
  ],
  "generic_hero": [
    "<(?:section|div)[^>]*class=\\\"[^\\\"]*hero[^\\\"]*\\\"",
    "<(?:section|div)[^>]*(?:id|class)=\\\"[^\\\"]*(?:hero|banner|jumbotron)[^\\\"]*\\\""
  ],
  "hero_structure_indicators": [
    "text-(?:center|align:\\s*center)",
    "(?:max-width|margin):\\s*(?:auto|0\\s+auto)",
    "<h1[^>]*>[^<]{10,80}</h1>\\s*<p[^>]*>[^<]{20,200}</p>\\s*<(?:a|button)"
  ],
  "three_column": [
    "grid-template-columns:\\s*repeat\\(\\s*3\\s*,",
    "class=\\\"[^\\\"]*(?:col-(?:md-|lg-)?4|grid-cols-3|three-col)",
    "flex(?:-wrap)?[^;]*;\\s*(?:[^}]*width:\\s*(?:33|calc\\(100%\\s*/\\s*3))"
  ],
  "feature_grid_block": "<div[^>]*>\\s*(?:<(?:svg|img|i|span)[^>]*(?:icon|svg|fa-)[^>]*>.*?</(?:svg|img|i|span)>|<(?:svg|img|i|span)[^>]*/?>)\\s*<h[2-4][^>]*>[^<]+</h[2-4]>\\s*<p[^>]*>[^<]+</p>\\s*</div>",
  "shadow": "box-shadow\\s*:",
  "backdrop_blur": "backdrop-filter\\s*:\\s*blur",
  "border_radius": "border-radius\\s*:\\s*(\\d+)",
  "pricing_table": [
    "class=\\\"[^\\\"]*(?:pricing|price|plan)[^\\\"]*\\\"",
    "(?:popular|recommended|best\\s*value|most\\s*popular)",
    "\\$\\s*\\d+\\s*(?:/\\s*mo|per\\s*month|/month)"
  ],
  "testimonial": [
    "class=\\\"[^\\\"]*(?:testimonial|review|quote)[^\\\"]*\\\"",
    "<(?:img|div)[^>]*(?:avatar|profile|headshot|rounded-full|border-radius:\\s*50%)",
    "<blockquote|<q\\b"
  ],
  "generic_cta": [
    "\\bget\\s+started\\b",
    "\\blearn\\s+more\\b",
    "\\btry\\s+(?:it\\s+)?free\\b",
    "\\bsign\\s+up\\s+(?:now|today|free)\\b",
    "\\bstart\\s+(?:your\\s+)?(?:free\\s+)?trial\\b",
    "\\bjoin\\s+(?:now|today|us)\\b",
    "\\bbook\\s+a\\s+demo\\b",
    "\\bschedule\\s+a\\s+(?:call|demo)\\b",
    "\\bcontact\\s+(?:us|sales)\\b"
  ],
  "buzzwords": [
    "\\bseamless(?:ly)?\\b",
    "\\bpowerful\\b",
    "\\brevolutionar(?:y|ize)\\b",
    "\\bnext[\\s-]gen(?:eration)?\\b",
    "\\bcutting[\\s-]edge\\b",
    "\\binnovative\\b",
    "\\btransform(?:ative)?\\b",
    "\\bunlock\\b",
    "\\bleverage\\b",
    "\\bsupercharge\\b",
    "\\bstreamline\\b",
    "\\bempower\\b",
    "\\bgame[\\s-]chang(?:er|ing)\\b",
    "\\bworld[\\s-]class\\b",
    "\\bstate[\\s-]of[\\s-]the[\\s-]art\\b",
    "\\bfrictionless\\b",
    "\\brobust\\b",
    "\\bscalable\\b",
    "\\bholistic\\b",
    "\\bsynergy\\b"
  ],
  "placeholder_text": [
    "\\blorem\\s+ipsum\\b",
    "\\bdolor\\s+sit\\s+amet\\b",
    "\\bconsectetur\\s+adipiscing\\b",
    "\\bsed\\s+do\\s+eiusmod\\b",
    "\\but\\s+labore\\s+et\\s+dolore\\b",
    "\\bplaceholder\\b",
    "\\bTODO\\b",
    "\\bFIXME\\b",
    "\\bXXX\\b"
  ],
  "template_section_order": [
    "hero",
    "feature",
    "testimonial",
    "pricing",
    "cta",
    "footer"
  ],
  "icon_sets": {
    "fontawesome": "fa-[a-z]",
    "material": "material-icons|mat-icon",
    "heroicons": "heroicon",
    "feather": "feather-",
    "lucide": "lucide-",
    "phosphor": "ph-",
    "tabler": "tabler-icon|ti-",
    "bootstrap": "bi-",
    "ionicons": "ion-",
    "outlined_svg": "stroke-width|stroke=\\\"|fill=\\\"none\\\"",
    "filled_svg": "fill=\\\"(?!none)[^\\\"]+\\\"[^>]*(?!stroke)"
  }
}
