        },
        "notes": [
          "auth: set SESSION_SECRET (32+ characters) and add app/api/auth/login and app/api/auth/register route handlers that check credentials against your user store and set the cookie with createSessionToken() from lib/auth.ts."
        ]
      },
      "react": {
        "files": {
