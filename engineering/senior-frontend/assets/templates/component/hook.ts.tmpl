import {{ useCallback, useState }} from 'react';

export interface Use{name}Options {{
  /** The async work run() performs; replace with what this hook wraps. */
  onRun?: () => Promise<void>;
}}

export interface Use{name}Return {{
  isLoading: boolean;
  error: Error | null;
  run: () => Promise<void>;
}}

export function use{name}({{ onRun }}: Use{name}Options = {{}}): Use{name}Return {{
  const [isLoading, setIsLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  const run = useCallback(async () => {{
    setIsLoading(true);
    setError(null);
    try {{
      await onRun?.();
    }} catch (err) {{
      setError(err instanceof Error ? err : new Error(String(err)));
    }} finally {{
      setIsLoading(false);
    }}
  }}, [onRun]);

  return {{ isLoading, error, run }};
}}
