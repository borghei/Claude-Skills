  },
  "ing_riders": {
    "severity": "budget",
    "budget": 1,
    "why": "A participle tacked onto a fact adds a claim with no subject.",
    "patterns": [
      ",\\s+(ensuring|allowing|enabling|empowering|helping|making it|giving you|letting you|providing)\\b"
    ]
  },
  "reveals": {
    "severity": "warn",
    "why": "Staged suspense and process talk make the page talk about itself.",
    "patterns": [
      "\\bthe result\\?",
      "\\bthe catch\\?",
      "\\bthe secret\\?",
      "\\bhere's how\\b",
      "\\bthis section\\b",
      "\\bbelow,? you'll find\\b",
      "\\bhere are \\d+ reasons\\b",
      "\\bone thing changed:",
      "\\bthe answer:"
    ]
  },
  "puffery": {
    "severity": "warn",
    "why": "Dead metaphors and inflated verbs where \"is\" or a street name would do.",
    "patterns": [
      "\\bserves as\\b",
      "\\bstands as\\b",
      "\\bplays a (key|pivotal|vital) role\\b",
      "\\bin the heart of\\b",
      "\\bwhere \\w+ meets \\w+\\b",
      "\\becosystem\\b",
      "\\blandscape\\b",
      "\\bjourney\\b",
      "\\bthe world of\\b",
      "\\bin the \\w+ space\\b"
    ]
  },
  "proof_figures": {
    "severity": "warn",
    "why": "Round, unsourced figures read as invented. Use the brief's numbers, in a sentence, with a unit.",
    "patterns": [
      "\\b\\d{1,3}(,\\d{3})+\\+",
      "\\b\\d+[kKmM]\\+",
      "\\b\\d+(\\.\\d+)?x (faster|better|more|cheaper)\\b",
      "\\b(9[5-9]|100)% (of )?(customers|users|satisfaction|satisfied|uptime)\\b"
    ]
  },
