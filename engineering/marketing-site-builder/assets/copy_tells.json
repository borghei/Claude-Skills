  "contrast_frames": {
    "severity": "budget",
    "budget": 2,
    "why": "\"X, not Y\" and its substitutes become a tic when every section uses one.",
    "patterns": [
      ",\\s+not\\s+\\w+",
      "\\bisn't (just )?a\\b",
