# Fake values for the demo. SENTRY_DSN is missing here (key drift) and
# LEGACY_API_TOKEN exists only here.
APP_ENV=production
APP_PORT=8080
DATABASE_URL=postgres://app:${DB_PASSWORD}@db.prod.internal:5432/app
